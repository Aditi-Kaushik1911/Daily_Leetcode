class Solution:
    def maxAbsoluteSum(self, nums: List[int]) -> int:
        max_sum=nums[0]
        ans=abs(nums[0])
        min_sum=nums[0]
        for i in range(1,len(nums)):
            v1=nums[i]
            v2=max_sum +nums[i]
            v3=min_sum + nums[i]
            min_sum=min(v1,min(v2,v3))
            max_sum=max(v1,max(v2,v3))
            ans=max(ans,abs(max_sum),abs(min_sum))
        return ans

        
