class Solution:
    def maximumSum(self, arr: List[int]) -> int:
        if len(arr)==1:
            return arr[0]
        one_delete=float('-inf')
        no_delete=arr[0]
        ans=arr[0]
        for i in range(1,len(arr)):
            old_no_delete = no_delete
            no_delete = max(arr[i],old_no_delete + arr[i])
            one_delete = max(old_no_delete, one_delete + arr[i])
            ans = max(ans, no_delete, one_delete)
        return ans

        
