class Solution:
    def subarraysDivByK(self, nums: List[int], k: int) -> int:
        remainder_count = {0:1}
        count =0
        curr_sum =0
        for num in nums:
            curr_sum +=num
            remainder = curr_sum % k
            if remainder in remainder_count:
                count += remainder_count[remainder]
            remainder_count[remainder] = remainder_count. get (remainder,0)+1
        return count
